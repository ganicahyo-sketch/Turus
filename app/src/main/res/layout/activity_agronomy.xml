<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/text_main"
            android:textSize="30sp"
            android:background="@drawable/bg_chip"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="DATA LAHAN &amp; AGRONOMI"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="16sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_panel"
                android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. DATA LAHAN &amp; TANAMAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <EditText android:id="@+id/cropA" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:hint="Jenis tanaman, contoh: kelapa sawit" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true"/>
                <EditText android:id="@+id/ageMonths" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Umur tanaman (bulan)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/areaHa" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Luas lahan (ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/soilPh" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="pH tanah" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/soilN" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="N tersedia (mg/kg, sesuai hasil uji)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/soilP" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="P tersedia (mg/kg, sesuai hasil uji)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/soilK" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="K tersedia (mg/kg, sesuai hasil uji)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/soilEc" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="EC tanah (uS/cm)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/soilMoisture" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Kelembapan tanah (%)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <TextView android:id="@+id/saveFarm" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="9dp" android:gravity="center" android:text="SIMPAN DATA" android:textColor="@color/navy_950" android:textStyle="bold" android:background="@drawable/bg_button"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. TARGET HARA UNTUK HITUNG DOSIS" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Isi angka acuan dari rekomendasi tanaman/lokasi Anda. Aplikasi tidak mengarang target baru jika belum ada." android:textColor="@color/text_muted" android:textSize="11sp"/>
                <EditText android:id="@+id/targetN" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:hint="Target nitrogen / N (kg/ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/targetP" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Target fosfor / P2O5 (kg/ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/targetK" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Target kalium / K2O (kg/ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/targetDolomite" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Target dolomit (kg/ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/targetManure" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Target pupuk kandang (kg/ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <EditText android:id="@+id/targetPoc" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:hint="Target POC (L/ha)" android:textColorHint="@color/text_muted" android:textColor="@color/text_main" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingStart="12dp" android:paddingEnd="12dp"/>
                <TextView android:id="@+id/calculate" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="9dp" android:gravity="center" android:text="HITUNG DOSIS BERIKUTNYA" android:textColor="@color/navy_950" android:textStyle="bold" android:background="@drawable/bg_button"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. HASIL HITUNG &amp; 4 TEPAT PEMUPUKAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:id="@+id/recommendation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Belum dihitung." android:textColor="@color/text_main" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4. RIWAYAT PEMUPUKAN" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Catat produk, dosis, kandungan N/P2O5/K2O, cara dan umur tanaman saat aplikasi." android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:id="@+id/addFertilizer" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:gravity="center" android:text="+ TAMBAH RIWAYAT PUPUK" android:textColor="@color/navy_950" android:textStyle="bold" android:background="@drawable/bg_button"/>
                <TextView android:id="@+id/fertHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Belum ada riwayat pemupukan." android:textColor="@color/text_main" android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5. RIWAYAT PENGENDALIAN OPT" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Catat pengamatan, cara manual/mekanis/kimia, produk, bahan aktif, dosis label, konsentrasi, volume air, interval dan hasil." android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:id="@+id/addOpt" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:gravity="center" android:text="+ TAMBAH RIWAYAT OPT" android:textColor="@color/navy_950" android:textStyle="bold" android:background="@drawable/bg_button"/>
                <TextView android:id="@+id/optHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Belum ada riwayat pengendalian OPT." android:textColor="@color/text_main" android:textSize="11sp"/>
                <TextView android:id="@+id/optAnalysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Analisis OPT: belum ada." android:textColor="@color/text_main" android:textSize="11sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="6. ANALISIS AI AGRONOMI" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="11sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="AI membaca data lahan, target hara, riwayat pupuk, dan riwayat OPT. AI tidak membuat dosis pestisida baru di luar data label." android:textColor="@color/text_muted" android:textSize="11sp"/>
                <TextView android:id="@+id/aiAgronomyButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="9dp" android:gravity="center" android:text="ANALISIS LENGKAP DENGAN AI" android:textColor="@color/navy_950" android:textStyle="bold" android:background="@drawable/bg_button"/>
                <TextView android:id="@+id/aiAgronomyStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="AI belum dijalankan." android:textColor="@color/text_muted" android:textSize="10sp"/>
                <TextView android:id="@+id/aiAgronomyAdvice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Belum ada analisis AI." android:textColor="@color/text_main" android:textSize="12sp" android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
